# Copie este arquivo para ".env" e ajuste os valores. O ".env" NÃO deve ser publicado.
# Nenhum valor abaixo é obrigatório para usar o app no seu computador.
# Na hospedagem, coloque estes valores no painel de segredos do serviço (veja docs/PUBLICACAO.md).

# desenvolvimento (padrão) ou producao
ASSISTENTE_AMBIENTE=desenvolvimento

# Contas de usuário: "sim" = cada pessoa tem login e dados separados.
# Padrão: ligado em produção, desligado no uso local.
ASSISTENTE_CONTAS=

# Se definido, só cria conta quem souber este código (recomendado ao publicar).
ASSISTENTE_CODIGO_CONVITE=

# Banco online (PostgreSQL). Vazio = SQLite local no arquivo abaixo.
# Formato: postgresql://<usuario>:<senha>@<endereco>/<banco>?sslmode=require
ASSISTENTE_DATABASE_URL=

# Caminho do banco SQLite local. Relativo à pasta do projeto ou absoluto.
ASSISTENTE_BANCO=dados/assistente.db

# INFO, WARNING ou ERROR (padrão: INFO em desenvolvimento, WARNING em produção)
ASSISTENTE_NIVEL_LOG=INFO

# Senha única para abrir o app no modo SEM contas (ex.: acesso pelo celular na rede de casa).
ASSISTENTE_SENHA_ACESSO=

# Provedor do chat. Só "regras" (local, gratuito) existe nesta versão.
ASSISTENTE_IA_PROVEDOR=regras
